# Theme: Catppuccin Macchiato, aligned with Neovim.
background = #24273a
foreground = #cad3f5
selection-background = #5b6078
selection-foreground = #cad3f5

palette = 0=#494d64
palette = 1=#ed8796
palette = 2=#a6da95
palette = 3=#eed49f
palette = 4=#8aadf4
palette = 5=#f5bde6
palette = 6=#8bd5ca
palette = 7=#b8c0e0
palette = 8=#5b6078
palette = 9=#ed8796
palette = 10=#a6da95
palette = 11=#eed49f
palette = 12=#8aadf4
palette = 13=#f5bde6
palette = 14=#8bd5ca
palette = 15=#a5adcb

# Keep the cursor as a solid block. Disable Ghostty shell integration entirely
# so injected shell hooks cannot switch it back to a bar/line cursor.
cursor-style = block
cursor-style-blink = false
cursor-color = #f4dbd6
cursor-text = #24273a
shell-integration = none

background-opacity = 0.92
background-blur = true
unfocused-split-opacity = 0.85
window-padding-x = 10
window-padding-y = 8
window-padding-balance = true
minimum-contrast = 1.15

font-family = "FiraCode Nerd Font Mono"
font-size = 14
font-thicken = true

# Make Alt/Meta mappings work consistently in Neovim and through tmux.
macos-option-as-alt = true

keybind = shift+enter=text:\n
